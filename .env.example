# 数据库
DATABASE_URL=postgresql+psycopg://orionai:orionai@localhost:5432/orionai

# redis
REDIS_URL=redis://localhost:6379/0

# 邮件验证码与认证会话
AUTH_CODE_PEPPER=
AUTH_COOKIE_NAME=orionai_session
AUTH_SESSION_TTL_SECONDS=604800
# 未设置时，production 环境自动启用 Secure Cookie
# AUTH_COOKIE_SECURE=true

# SMTP（设置 AUTH_CODE_PEPPER 和以下邮件配置后才能发送验证码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OrionAI
SMTP_USE_SSL=true
