# 本地开发变量示例。复制为 .env 后按需修改；不要填入真实密钥。
ENVIRONMENT=development
POSTGRES_DB=orionai
POSTGRES_USER=orionai
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 宿主机运行后端使用 localhost；Compose 会为容器设置内部服务地址。
DATABASE_URL=postgresql+psycopg://orionai:change-this-local-password@localhost:5432/orionai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]