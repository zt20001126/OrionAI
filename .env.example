# 数据库
DATABASE_URL=postgresql+psycopg://orionai:orionai@localhost:5432/orionai

# redis
REDIS_URL=redis://localhost:6379/0

# AUTH
AUTH_CODE_PEPPER=

# SMTP
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Snowflake 节点 ID；同时运行多个 backend 实例时需分别设置为不同值
SNOWFLAKE_WORKER_ID=1

# 阿里云 OSS（当前应用未接入；Bucket 应保持私有）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_OBJECT_PREFIX=orionai
